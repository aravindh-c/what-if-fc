// KeyMoments(p_match_id) – detect the four key moment types.
//
// Moment types and trigger conditions (mirror analytics.metrics.key_moments()):
//
//   goal
//     event_type == "goal"
//     value = 1.0, score = 1.0
//
//   high_pressure_final_third_pass
//     event_type == "pass"
//     x >= 80  (final third in possessing team's frame)
//     pressure_level >= 0.6
//     snapshot_id is not null
//     value = pressure_level
//     score = clamp(0.3 + 0.4*pressure_level + 0.3*(x-80)/25, 0, 1)
//
//   final_third_turnover
//     event_type in ("tackle","interception") AND outcome == "won"
//     x >= 80  (in the possessing team's frame at the time of the turnover)
//     value = x
//     score = clamp(0.4 + 0.4*(x-80)/25, 0, 1)
//
//   momentum_swing
//     Computed from Momentum(): first minute >= 8 where the rolling-window leader
//     changes and the new leader's share >= 0.60.
//     value = new leader's share, score = 0.7
//
// Coordinate rule: x,y in the possessing team's frame (attacking towards x=105).

.create-or-alter function with (folder="whatif") KeyMoments(p_match_id:string) {
    // ── Direct event triggers ──────────────────────────────────────────────
    let direct = EventsClean()
        | where match_id == p_match_id and isnotempty(team_id)
        | extend moment_type = case(
            event_type == "goal",
                "goal",
            event_type == "pass" and x >= 80.0
                and pressure_level >= 0.6 and isnotempty(snapshot_id),
                "high_pressure_final_third_pass",
            event_type in ("tackle","interception")
                and outcome == "won" and x >= 80.0,
                "final_third_turnover",
            ""
        )
        | where isnotempty(moment_type)
        | extend
            moment_id = strcat("km_", event_id),
            value = case(
                moment_type == "goal",                           1.0,
                moment_type == "high_pressure_final_third_pass", pressure_level,
                todouble(x)
            ),
            score = case(
                moment_type == "goal",
                    1.0,
                moment_type == "high_pressure_final_third_pass",
                    min_of(1.0, max_of(0.0, 0.3 + 0.4 * pressure_level + 0.3 * ((x - 80.0) / 25.0))),
                moment_type == "final_third_turnover",
                    min_of(1.0, max_of(0.0, 0.4 + 0.4 * ((x - 80.0) / 25.0))),
                0.0
            )
        | project moment_id, match_id, match_clock_s, moment_type,
                  team_id, event_id, snapshot_id, value, score;
    // ── Momentum swing ────────────────────────────────────────────────────
    // Track all dominant leaders; emit swing only at minute >= 8.
    let mom = Momentum(p_match_id)
        | where share >= 0.60
        | summarize arg_max(share, team_id) by minute
        | order by minute asc
        | extend prev_team = prev(team_id)
        | where minute >= 8 and isnotempty(prev_team) and team_id != prev_team
        | extend clock = minute * 60;
    // Pick a representative event at the swing minute (first event for the new leader)
    let swing_events = EventsClean()
        | where match_id == p_match_id and isnotempty(team_id);
    let swings = mom
        | join kind=inner (
            swing_events
            | summarize event_id = take_any(event_id),
                        snapshot_id = take_any(snapshot_id)
              by minute = match_clock_s / 60, team_id
          ) on minute, $left.team_id == $right.team_id
        | extend
            moment_id = strcat("km_swing_", p_match_id, "_", tostring(clock)),
            moment_type = "momentum_swing",
            match_clock_s = clock,
            value = max_share,  // from arg_max
            score = 0.7
        | project moment_id, match_id=p_match_id, match_clock_s, moment_type,
                  team_id, event_id, snapshot_id, value, score;
    // ── Union and sort ─────────────────────────────────────────────────────
    union direct, swings
    | order by match_clock_s asc
}

// Example: KeyMoments("match_s7_T01_T02")
