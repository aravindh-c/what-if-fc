// events table – created automatically by the Eventstream destination dst-events.
// Pipeline: Eventstream whatif-es  →  source src-simulator (custom endpoint, Event Hub-compatible)
//           →  destination dst-events  →  Eventhouse whatif / database whatif / table events
//           Payload format: JSON, one MatchEvent per message.
//
// Schema (.show table events schema as csl):
// event_id:string,match_id:string,scenario_id:string,seed:long,event_time:string,match_clock_s:long,period:long,event_type:string,team_id:string,player_id:string,possession_id:long,x:real,y:real,end_x:real,end_y:real,outcome:string,receiver_id:string,pressure_level:real,snapshot_id:string,EventProcessedUtcTime:datetime,PartitionId:long,EventEnqueuedUtcTime:datetime,

// ── Quick check ──────────────────────────────────────────────────────────────
events
| summarize events = count() by event_type
| order by events desc

