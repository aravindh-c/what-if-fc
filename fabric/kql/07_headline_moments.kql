// HeadlineMoments(p_match_id) – select the most important key moments for display.
//
// Rules (mirror analytics.metrics.headline_moments(window_s=180, cap=12)):
//   - All goals are always included.
//   - Non-goal candidates are window-deduplicated:
//       for each bin(match_clock_s, 180) keep the row with the highest score
//       (arg_max(score, *); ties are resolved arbitrarily — rare in practice).
//   - From the survivors, take the top (12 − n_goals) by score descending
//       (ties broken by earlier match_clock_s).
//   - Return goals + selected non-goals, sorted by match_clock_s.
//
// Coordinate rule: x,y in the possessing team's frame (attacking towards x=105).

.create-or-alter function with (folder="whatif") HeadlineMoments(p_match_id:string) {
    let candidates = KeyMoments(p_match_id);
    let goals = candidates
        | where moment_type == "goal";
    let n_goals = toscalar(goals | count);
    let n_slots = max_of(0, 12 - n_goals);
    // Window-deduplicate non-goals: keep best score per 180-second bin
    let deduped = candidates
        | where moment_type != "goal"
        | extend win = match_clock_s / 180
        | summarize arg_max(score, *) by win
        | project-away win;
    // Rank survivors by score desc, clock asc; keep top n_slots
    let selected = deduped
        | sort by score desc, match_clock_s asc
        | extend rn = row_number()
        | where rn <= n_slots
        | project-away rn;
    // Combine and sort
    union goals, selected
    | order by match_clock_s asc
}

// Example: HeadlineMoments("match_s7_T01_T02")
