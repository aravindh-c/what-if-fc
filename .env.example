# Copy to .env and fill in locally. Never commit .env.

# --- Fabric Eventstream (custom endpoint, Event Hub-compatible) ---
EVENTSTREAM_CONNECTION_STRING=
EVENTSTREAM_NAME=

# --- Fabric Eventhouse (KQL) ---
KQL_CLUSTER_URI=
KQL_DATABASE=

# --- Microsoft Foundry ---
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# --- Azure Blob Storage (replay store) ---
REPLAY_STORAGE_ACCOUNT_URL=
REPLAY_CONTAINER=replay

# --- App ---
WHATIF_MODE=replay   # replay | live
